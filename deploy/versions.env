# Версии выкатки nabu-core (FTR.NAB.CMN-0001, по образцу FTR.HMR.INFRA-0002).
# Меняются только через PR: так выкатка любого тега воспроизводима.

# Тег репозитория nabu с переиспользуемым workflow deploy-component.yml.
# После изменения выполните deploy/sync-ref.sh — он подставит его в release.yml
# (в uses: нельзя использовать выражения).
DEPLOY_WORKFLOW_REF=v0.1.1

# Версия чартов nabu-core и nabu-web в oci://ghcr.io/greenongrey/charts —
# их публикует релиз hammurapi-infra вместе с чартами Hammurapi (тег стенда
# vX.Y.Z → X.Y.Z), как CHART_VERSION в hammurapi-core.
CHART_VERSION=0.2.3

# Агент Pi в образе (@earendil-works/pi-coding-agent). Обновление — отдельным
# PR: контрактные тесты pkg/pirpc и расширения nabu-workspace запускаются
# против этой версии.
PI_VERSION=1.1.0

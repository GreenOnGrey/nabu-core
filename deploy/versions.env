# Versions of the rollout of nabu-core (FTR.NAB.CMN-0001, modelled on FTR.HMR.INFRA-0002).
# They change only through a PR, so a rollout of any tag is reproducible.

# The tag of the repository nabu with the reusable workflow deploy-component.yml.
# After a change, run deploy/sync-ref.sh: it puts the tag into release.yml
# (uses: takes no expressions).
DEPLOY_WORKFLOW_REF=v0.1.3

# The version of the charts nabu-core and nabu-web in oci://ghcr.io/greenongrey/charts:
# a release of installer publishes them together with the charts of Hammurapi (tag of the stand
# vX.Y.Z → X.Y.Z), like CHART_VERSION in hammurapi-core.
CHART_VERSION=0.3.0

# The agent Pi in the image (@earendil-works/pi-coding-agent). An update goes in a separate
# PR: the contract tests of pkg/pirpc and of the extension nabu-workspace run
# against this version.
PI_VERSION=1.5.0
